# Opcional. Sin ninguna de las dos, el demo corre en modo offline (reglas + tools
# reales, sin LLM para redactar las respuestas).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar si hay una API key configurada.
# AGENT_MODEL=gpt-4o-mini

# Obligatorias para portafolio/compra reales (src/broker/ppi_broker.py).
# Generalas en la web de PPI en Configuración → API — NO son tu usuario y
# contraseña de la web/app, son un par de API keys separado.
# PPI_PUBLIC_KEY=
# PPI_PRIVATE_KEY=
# PPI_ACCOUNT_NUMBER=

# Opcional. true para operar contra el entorno sandbox de PPI en vez de producción.
# PPI_SANDBOX=false

# Opcional. Plazo de liquidación usado para cotizar y operar GGAL/YPF.
# PPI_PLAZO=A-24HS

# Usadas por mcp_server/server.py (integración con Hermes Agent, ver README).
#
# Por defecto (sin esta variable, o en cualquier valor distinto de "true")
# buy_stock corre en modo dry-run: simula la compra sin tocar PPI, aunque el
# cliente ya haya confirmado la orden. Poné esto en "true" a propósito
# cuando quieras que Hermes pueda ejecutar compras reales de GGAL/YPF.
# ALLOW_REAL_TRADES=false

# Opcional. Hermes no expone un session id estándar a los MCP servers; si en
# tu versión sí lo hace, seteá esta variable en el entorno del MCP server
# (no acá, en config.yaml) para que la auditoría en data/memory.db separe
# threads en vez de agrupar todo bajo "hermes".
# HERMES_SESSION_ID=hermes
